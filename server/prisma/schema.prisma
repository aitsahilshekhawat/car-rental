generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
  manager
  host
}

enum AuthProvider {
  local
  google
  phone
}

enum HostStatus {
  none
  pending
  approved
  rejected
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  created
  paid
  failed
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  password            String       @default("")
  role                UserRole     @default(user)
  googleId            String?      @unique
  authProvider        AuthProvider @default(local)
  profilePicture      String       @default("")
  phone               String?
  resetPasswordToken  String?
  resetPasswordExpire DateTime?

  hostBio             String?
  hostCity            String?
  hostStatus          HostStatus   @default(none)

  cars                Car[]
  bookings            Booking[]
  reviews             Review[]
  payments            Payment[]
  favoriteCars        FavoriteCar[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Car {
  id                String        @id @default(uuid())
  name              String
  brand             String
  type              String
  pricePerDay       Float
  fuelType          String
  transmission      String
  seatingCapacity   Int
  location          String
  image             String
  available         Boolean       @default(true)
  averageRating     Float         @default(0)
  totalReviews      Int           @default(0)

  ownerId           String?
  owner             User?         @relation(fields: [ownerId], references: [id])
  bookings          Booking[]
  reviews           Review[]
  favoritedBy       FavoriteCar[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([ownerId])
  @@index([location])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  carId       String
  car         Car           @relation(fields: [carId], references: [id])
  pickupDate  DateTime
  returnDate  DateTime
  totalPrice  Float
  status      BookingStatus @default(PENDING)

  payment     Payment?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([carId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  rating    Int
  comment   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, carId])
  @@index([carId])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  bookingId         String?       @unique
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(created)
  receipt           String

  bookingCarId      String?
  bookingPickupDate DateTime?
  bookingReturnDate DateTime?
  bookingTotalPrice Float?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
}

model FavoriteCar {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, carId])
}
